            "value": "Liviqa"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Privacy - Calendars Full Access Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Liviqa reads how full your days are, never what is in them. It keeps only numbers: how many entries a day held, how many hours were booked, the longest unbroken run of them, how many hours nothing was booked over, and when the first entry started and the last one ended. Titles, people, places, notes and the names of your calendars are never read, never stored and never sent anywhere."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "comment": "Privacy - Calendars Write Only Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Liviqa adds a consultation you plan to your own calendar, with a reminder. This permission lets Liviqa write that one event and nothing else — it gives Liviqa no way to read anything in your calendar."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa bruger kun dit kamera under en videokonsultation, du selv starter med din egen kliniker eller coach, over en EU-suveræn forbindelse. Det bruges aldrig ellers."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Liviqa uses your camera only during a video consultation you start with your own clinician or coach, over an EU‑sovereign connection. It is never used otherwise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa usa tu cámara solo durante una videoconsulta que tú inicias con tu propio clínico o coach, por una conexión soberana de la UE. Nunca se usa en otro caso."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa bruker kameraet ditt kun under en videokonsultasjon du selv starter med din egen kliniker eller coach, over en EU-suveren forbindelse. Det brukes aldri ellers."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Liviqa usa a sua câmara apenas durante uma videoconsulta que o próprio inicia com o seu clínico ou coach, numa ligação soberana da UE. Nunca é usada noutras situações."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa använder din kamera endast under en videokonsultation som du själv startar med din egen kliniker eller coach, över en EU-suverän anslutning. Den används aldrig annars."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "comment": "Privacy - Health Share Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa læser dine sundhedsdata på enheden for at vise dine tendenser og personlige indsigter i et klart sprog. Dine sundhedsdata bliver på denne enhed og uploades aldrig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Liviqa reads your Health data on-device to show your trends and personal, plain-language nudges. Your health data stays on this device and is never uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa lee tus datos de Salud en el dispositivo para mostrar tus tendencias y observaciones personales en lenguaje claro. Tus datos de salud permanecen en este dispositivo y nunca se suben."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa leser helsedataene dine på enheten for å vise trender og personlige innsikter i klart språk. Helsedataene dine blir på denne enheten og lastes aldri opp."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Liviqa lê os seus dados de Saúde no dispositivo para mostrar tendências e observações pessoais em linguagem clara. Os seus dados de saúde ficam neste dispositivo e nunca são carregados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa läser dina hälsodata på enheten för att visa dina trender och personliga insikter på klarspråk. Dina hälsodata stannar på denna enhet och laddas aldrig upp."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "comment": "Privacy - Health Update Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa har kun læseadgang og skriver aldrig til Apple Sundhed. Den læser kun dine data på enheden for at vise dine tendenser og personlige indsigter; intet skrives tilbage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Liviqa is read-only and never writes to Apple Health. It only reads your data on-device to show your trends and personal nudges; nothing is written back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa es de solo lectura y nunca escribe en Apple Salud. Solo lee tus datos en el dispositivo para mostrar tendencias y observaciones personales; nada se escribe de vuelta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa har kun lesetilgang og skriver aldri til Apple Helse. Den leser kun dataene dine på enheten for å vise trender og personlige innsikter; ingenting skrives tilbake."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Liviqa é só de leitura e nunca escreve no Apple Saúde. Apenas lê os seus dados no dispositivo para mostrar tendências e observações pessoais; nada é escrito de volta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa har endast läsbehörighet och skriver aldrig till Apple Hälsa. Den läser bara dina data på enheten för att visa trender och personliga insikter; inget skrivs tillbaka."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa bruger kun din mikrofon under en videokonsultation, du selv starter med din egen kliniker eller coach, over en EU-suveræn forbindelse. Den bruges aldrig ellers."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Liviqa uses your microphone only during a video consultation you start with your own clinician or coach, over an EU‑sovereign connection. It is never used otherwise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa usa tu micrófono solo durante una videoconsulta que tú inicias con tu propio clínico o coach, por una conexión soberana de la UE. Nunca se usa en otro caso."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa bruker mikrofonen din kun under en videokonsultasjon du selv starter med din egen kliniker eller coach, over en EU-suveren forbindelse. Den brukes aldri ellers."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Liviqa usa o seu microfone apenas durante uma videoconsulta que o próprio inicia com o seu clínico ou coach, numa ligação soberana da UE. Nunca é usado noutras situações."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liviqa använder din mikrofon endast under en videokonsultation som du själv startar med din egen kliniker eller coach, över en EU-suverän anslutning. Den används aldrig annars."
          }
        }
      }
    }
  },
  "version": "1.2"
}
