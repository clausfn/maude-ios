    "Every access to your data is recorded here. " : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver adgang til dine data registreres her. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada acceso a tus datos se registra aquí. "
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver tilgang til dataene dine registreres her. "
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada acesso aos seus dados é registado aqui. "
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje åtkomst till dina data registreras här. "
