    "…came after a late meal. Only 22% followed an early one." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…kom efter et sent måltid. Kun 22% fulgte efter et tidligt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…vinieron tras una comida tardía. Solo el 22% siguió a una temprana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…kom etter et sent måltid. Bare 22% fulgte etter et tidlig."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…vieram depois de uma refeição tardia. Apenas 22% se seguiram a uma cedo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…kom efter en sen måltid. Bara 22% följde på en tidig."
          }
        }
      }
    },
