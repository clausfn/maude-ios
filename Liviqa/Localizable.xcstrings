        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla ändringar i delning loggas oberoende och kan inte ändras."
          }
        }
      }
    },
    "All sources are processed on this device. Patterns are extracted locally — raw data is never sent anywhere." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle kilder behandles på denne enhed. Mønstre udledes lokalt — rådata sendes aldrig nogen steder hen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las fuentes se procesan en este dispositivo. Los patrones se extraen localmente — los datos en bruto nunca se envían a ningún sitio."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle kilder behandles på denne enheten. Mønstre hentes ut lokalt — rådata sendes aldri noe sted."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
