      }
    },
    "These things happen on a busy day. You can reschedule and we'll find another time." : {

    },
    "These values come from your care plan. Liviqa uses them to calibrate what's inside vs outside your personal range." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse værdier kommer fra din behandlingsplan. Liviqa bruger dem til at kalibrere, hvad der er inden for og uden for dit personlige område."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos valores provienen de tu plan de cuidados. Liviqa los usa para calibrar qué está dentro y fuera de tu rango personal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse verdiene kommer fra behandlingsplanen din. Liviqa bruker dem til å kalibrere hva som er innenfor og utenfor ditt personlige område."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes valores vêm do seu plano de cuidados. O Liviqa usa-os para calibrar o que está dentro e fora do seu intervalo pessoal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessa värden kommer från din vårdplan. Liviqa använder dem för att kalibrera vad som är inom respektive utanför ditt personliga område."
          }
        }
      }
    },
    "This file is stored encrypted on your device. Previews open once the production environment is live." : {
      "localizations" : {
