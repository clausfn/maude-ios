    "Eat earlier and, in your data, the pattern eases. Dinner before 20:30 is the lever." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spis tidligere, og i dine data aftager mønstret. Aftensmad før 20.30 er håndtaget."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena antes y, en tus datos, el patrón se suaviza. Cenar antes de las 20:30 es la palanca."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spis tidligere, og i dine data avtar mønsteret. Middag før 20.30 er spaken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jante mais cedo e, nos seus dados, o padrão atenua-se. Jantar antes das 20:30 é a alavanca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ät tidigare, och i dina data avtar mönstret. Middag före 20.30 är spaken."
          }
        }
      }
    },
