    "This will permanently delete all local Liviqa data, including your health records, vault files, journal entries, and nudge history. It cannot be undone." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter permanent alle lokale Liviqa-data, herunder dine helbredsoplysninger, filer i Health Vault, dagbogsnotater og indsigtshistorik. Det kan ikke fortrydes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará permanentemente todos los datos locales de Liviqa, incluidos tus registros de salud, archivos del Health Vault, entradas del diario e historial de observaciones. No se puede deshacer."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter permanent alle lokale Liviqa-data, inkludert helseopplysninger, filer i Health Vault, dagboknotater og innsiktshistorikk. Det kan ikke angres."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto elimina permanentemente todos os dados locais do Liviqa, incluindo registos de saúde, ficheiros do Health Vault, entradas do diário e histórico de observações. Não pode ser anulado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta raderar permanent alla lokala Liviqa-data, inklusive hälsouppgifter, filer i Health Vault, dagboksanteckningar och insiktshistorik. Det kan inte ångras."
          }
        }
      }
    },
