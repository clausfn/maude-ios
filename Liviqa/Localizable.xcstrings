    "DATA FOR GOOD FOUNDATION" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DATA FOR GOOD FOUNDATION"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DATA FOR GOOD FOUNDATION"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DATA FOR GOOD FOUNDATION"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DATA FOR GOOD FOUNDATION"
          }
        },
        "sv" : {
