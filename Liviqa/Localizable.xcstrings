    "Derived summaries only — no raw samples leave your device. You can revoke access in your Wallet at any time." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun afledte sammendrag — ingen rå målinger forlader din enhed. Du kan tilbagekalde adgangen i din wallet når som helst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo resúmenes derivados — ninguna muestra en bruto sale de tu dispositivo. Puedes revocar el acceso en tu wallet en cualquier momento."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun avledede sammendrag — ingen rå målinger forlater enheten din. Du kan tilbakekalle tilgangen i din wallet når som helst."
