    "Glucose dropped 35% more than usual after yesterday's ride, compared with your last six rides at similar intensity." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glukosen faldt 35% mere end normalt efter gårsdagens cykeltur, sammenlignet med dine seneste seks ture ved lignende intensitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La glucosa bajó un 35% más de lo habitual tras la salida de ayer, comparado con tus últimas seis salidas de intensidad similar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glukosen falt 35% mer enn vanlig etter gårsdagens sykkeltur, sammenlignet med dine siste seks turer ved lignende intensitet."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A glicose caiu 35% mais do que o habitual após a volta de ontem, em comparação com as suas últimas seis voltas de intensidade semelhante."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glukosen sjönk 35% mer än vanligt efter gårdagens cykeltur, jämfört med dina senaste sex turer vid liknande intensitet."
          }
        }
      }
    },
