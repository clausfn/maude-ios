    "Training pattern": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træningsmønster"
          }
        }
      }
    },
    "TRANSCRIPTION": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "TRANSSKRIPTION"
          }
        }
      }
    },
    "Trend chart": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendensdiagram"
          }
        }
      }
    },
    "Turn off & delete chat": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå fra & slet chat"
          }
        }
      }
    },
    "Two trackers logged the same session. Liviqa counts it once so minutes and energy are never doubled — and keeps the best of both recordings for insights.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "To enheder loggede samme træning. Liviqa tæller den én gang, så minutter og energi aldrig fordobles — og beholder det bedste fra begge optagelser til indsigterne."
          }
        }
      }
    },
    "Understood": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forstået"
          }
        }
      }
    },
    "Until": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtil"
          }
        }
      }
    },
    "Used to contextualise patterns — e.g. glucose drops after cycling at this intensity.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruges til at sætte mønstre i kontekst — fx at glukose falder efter cykling ved denne intensitet."
          }
        }
      }
    },
    "Used to pre-fill consent recipients. Role matters more than a person's name — people change, roles persist.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruges til at forudfylde samtykkemodtagere. Rollen betyder mere end navnet — personer skifter, roller består."
          }
        }
      }
    },
    "Valid until %@ — short validity by design. Renew any time from this screen.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyldig til %@ — kort gyldighed med vilje. Forny når som helst fra denne skærm."
          }
        }
      }
    },
    "verified": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "verificeret"
          }
        }
      }
    },
    "Verified with Partisia": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificeret med Partisia"
          }
        }
      }
    },
    "Verifying…": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificerer…"
          }
        }
      }
    },
    "Version 1.0": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Version 1.0"
          }
        }
      }
    },
    "Video consultation · %@": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Videokonsultation · %@"
          }
        }
      }
    },
    "View full log →": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se fuld log →"
          }
        }
      }
    },
    "View log →": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se log →"
          }
        }
      }
    },
    "View scope": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omfang"
          }
        }
      }
    },
    "Voice note": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Talenote"
          }
        }
      }
    },
    "What do you most want to understand or improve? (1–3 goals)": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad vil du helst forstå eller forbedre? (1–3 mål)"
          }
        }
      }
    },
    "What is the Data for Good Foundation?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad er Data for Good Foundation?"
          }
        }
      }
    },
    "WHO CAN SEE YOUR DATA · %lld ACTIVE": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "HVEM KAN SE DINE DATA · %lld AKTIVE"
          }
        }
      }
    },
    "Why this?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor dette?"
          }
        }
      }
    },
    "Withdraw": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbagekald"
          }
        }
      }
    },
    "Withdrawing stops future sharing immediately. Completed analyses are not affected. Every change is logged.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbagekaldelse stopper fremtidig deling med det samme. Afsluttede analyser påvirkes ikke. Hver ændring logges."
          }
        }
      }
    },
    "Withdrawn": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbagekaldt"
          }
        }
      }
    },
    "Write entry": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv notat"
          }
        }
      }
    },
    "Year": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "År"
          }
        }
      }
    },
    "Yes, delete everything": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, slet alt"
          }
        }
      }
    },
    "You can't be quietly overridden. Every access request is logged. Every refusal is logged. You can inspect the full record at any time.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke tilsidesættes i det stille. Hver adgangsforespørgsel logges. Hvert afslag logges. Du kan til enhver tid se hele loggen."
          }
        }
      }
    },
    "You earn tokens when your device contributes to anonymised research queries. Your health data never leaves this phone.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du optjener tokens, når din enhed bidrager til anonymiserede forskningsforespørgsler. Dine sundhedsdata forlader aldrig denne telefon."
          }
        }
      }
    },
    "You haven't shared data with anyone. This is the default.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke delt data med nogen. Det er standarden."
          }
        }
      }
    },
    "YOU'LL SHARE": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DU DELER"
          }
        }
      }
    },
    "Your care team": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit behandlerteam"
          }
        }
      }
    },
    "Your care team can view your patterns for 48 hours. This sharing is logged in your privacy record.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit behandlerteam kan se dine mønstre i 48 timer. Delingen registreres i din privatlivslog."
          }
        }
      }
    },
    "Your care team, on your terms": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit behandlerteam, på dine vilkår"
          }
        }
      }
    },
    "Your consent decisions are independently logged and cannot be edited by anyone — including Liviqa.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine samtykkebeslutninger logges uafhængigt og kan ikke redigeres af nogen — heller ikke Liviqa."
          }
        }
      }
    },
    "Your data belongs to you. Liviqa has no access to your raw records.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine data tilhører dig. Liviqa har ingen adgang til dine rå optegnelser."
          }
        }
      }
    },
    "Your data lives where you choose.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine data bor der, hvor du vælger."
          }
        }
      }
    },
    "Your data stays on this phone. You decide every exception, one by one.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine data bliver på denne telefon. Du bestemmer hver undtagelse, én ad gangen."
          }
        }
      }
    },
    "Your data stays on your device.\nNothing leaves without your consent.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine data bliver på din enhed.\nIntet forlader den uden dit samtykke."
          }
        }
      }
    },
    "YOUR DATA, YOUR WAY": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DINE DATA, PÅ DIN MÅDE"
          }
        }
      }
    },
    "Your documents, on this device, encrypted. File previews open after the live production test — until then the vault shows files, not contents.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine dokumenter, på denne enhed, krypteret. Forhåndsvisning åbner efter den endelige produktionstest — indtil da viser Health Vault filer, ikke indhold."
          }
        }
      }
    },
    "Your financial patterns stay in your Health Vault on this phone, beside your other documents. Encrypted, never part of any clinician share, never sent anywhere. Disconnect and erase them in one tap, any time.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine økonomiske mønstre bliver i din Health Vault på denne telefon, side om side med dine andre dokumenter. Krypteret, aldrig en del af nogen deling med klinikere, aldrig sendt nogen steder hen. Afbryd og slet dem med ét tryk, når som helst."
          }
        }
      }
    },
    "Your first grant or refusal will appear here.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din første tilladelse eller dit første afslag vises her."
          }
        }
      }
    },
    "Your identity is confirmed and your consent is anchored on the immutable CE ledger.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din identitet er bekræftet, og dit samtykke er forankret i den uforanderlige CE-hovedbog."
          }
        }
      }
    },
    "Your identity is confirmed. Only the facts you approved were shared with Liviqa.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din identitet er bekræftet. Kun de oplysninger, du godkendte, blev delt med Liviqa."
          }
        }
      }
    },
    "Your Liviqa Citizen credential": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Liviqa Citizen-legitimation"
          }
        }
      }
    },
    "Your name, date of birth and address are never revealed to Liviqa — only the facts above are proven.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit navn, din fødselsdato og din adresse afsløres aldrig for Liviqa — kun oplysningerne ovenfor bevises."
          }
        }
      }
    },
    "your normal %@–%@ %@": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "dit normale %1$@–%2$@ %3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "your normal %1$@–%2$@ %3$@"
          }
        }
      }
    },
    "Your own data, understood.\nNot averages — yours.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine egne data, forstået.\nIkke gennemsnit — dine."
          }
        }
      }
    },
    "YOUR PRIVACY RECORD": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DIN PRIVATLIVSLOG"
          }
        }
      }
    },
    "YOUR RANGE": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DIT OMRÅDE"
          }
        }
      }
    },
    "Your recipient": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din modtager"
          }
        }
      }
    },
    "Your rights under GDPR Articles 15–22 apply in full. Full legal text at liviqa.app/privacy": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine rettigheder efter GDPR artikel 15–22 gælder fuldt ud. Den fulde juridiske tekst findes på liviqa.app/privacy"
          }
        }
      }
    },
    "Your sharing settings are backed by an independent privacy record. Liviqa can read it — only you can change it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine delingsindstillinger hviler på en uafhængig privatlivslog. Liviqa kan læse den — kun du kan ændre den."
          }
        }
      }
    },
    "Your sign-in and participation credential — role and member ID only, pseudonymous by design. No name, no health data. Issuance is recorded in your Privacy Record.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din legitimation til login og deltagelse — kun rolle og medlems-ID, pseudonym fra grunden. Intet navn, ingen sundhedsdata. Udstedelsen registreres i din privatlivslog."
          }
        }
      }
    },
    "Your sovereign identity": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din suveræne identitet"
          }
        }
      }
    }
  },
  "version": "1.0"
}