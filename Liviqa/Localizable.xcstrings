        }
      }
    },
    "Every decision.\nPermanently recorded." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver beslutning.\nPermanent registreret."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada decisión.\nRegistrada permanentemente."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver beslutning.\nPermanent registrert."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada decisão.\nRegistada permanentemente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje beslut.\nPermanent registrerat."
          }
        }
      }
    },
    "Every time anyone requests your health data, a neutral record is created. Not by Liviqa. Not by the requester. By a foundation that answers to you — and represents your interests in the data economy." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang nogen beder om dine sundhedsdata, oprettes en neutral log. Ikke af Liviqa. Ikke af forespørgeren. Af en fond, der står til ansvar over for dig — og varetager dine interesser i dataøkonomien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que alguien solicita tus datos de salud se crea un registro neutral. No lo crea Liviqa. Ni el solicitante. Lo crea una fundación que responde ante ti — y representa tus intereses en la economía del dato."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang noen ber om helsedataene dine, opprettes en nøytral logg. Ikke av Liviqa. Ikke av forespørreren. Av en stiftelse som svarer til deg — og ivaretar dine interesser i dataøkonomien."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre que alguém pede os seus dados de saúde, é criado um registo neutro. Não pelo Liviqa. Não pelo requerente. Por uma fundação que responde perante si — e representa os seus interesses na economia dos dados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje gång någon begär dina hälsodata skapas en neutral logg. Inte av Liviqa. Inte av beställaren. Av en stiftelse som svarar inför dig — och företräder dina intressen i dataekonomin."
          }
        }
      }
    },
    "Everything looks stable. Message me here if anything changes." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt ser stabilt ud. Skriv til mig her, hvis noget ændrer sig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo parece estable. Escríbeme aquí si algo cambia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt ser stabilt ut. Skriv til meg her hvis noe endrer seg."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo parece estável. Escreva-me aqui se algo mudar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt ser stabilt ut. Skriv till mig här om något ändras."
          }
        }
      }
    },
