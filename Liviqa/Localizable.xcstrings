    "Your day timeline appears here" : {

    },
    "Your device recorded an irregular heart-rhythm signal. Liviqa does not interpret heart rhythm — please share this recording with %@." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din enhed registrerede et signal om uregelmæssig hjerterytme. Liviqa fortolker ikke hjerterytme — del venligst denne optagelse med %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dispositivo registró una señal de ritmo cardiaco irregular. Liviqa no interpreta el ritmo cardiaco — comparte este registro con %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enheten din registrerte et signal om uregelmessig hjerterytme. Liviqa tolker ikke hjerterytme — del gjerne dette opptaket med %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu dispositivo registou um sinal de ritmo cardíaco irregular. A Liviqa não interpreta o ritmo cardíaco — partilhe este registo com %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din enhet registrerade en signal om oregelbunden hjärtrytm. Liviqa tolkar inte hjärtrytm — dela gärna denna registrering med %@."
          }
        }
      }
    },
    "your doctor" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "din læge"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tu médico"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "legen din"
          }
        },
        "pt" : {
          "stringUnit" : {
