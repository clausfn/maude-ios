          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Banking (PSD2): lesetilgang gjennom bankens offisielle API, godkjent med MitID, kan når som helst tilbakekalles i banken din."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Banking (PSD2): acesso só de leitura através da API oficial do seu banco, autorizado com MitID, revogável no banco a qualquer momento."
          }
        },
