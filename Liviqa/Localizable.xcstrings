    "Late dinners track with restless sleep in your own data." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sene middage følges med urolig søvn i dine egne data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cenas tardías van de la mano con un sueño inquieto en tus propios datos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sene middager følges med urolig søvn i dine egne data."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jantares tardios andam a par com sono agitado nos seus próprios dados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sena middagar följs åt med orolig sömn i dina egna data."
          }
        }
