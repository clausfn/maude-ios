    "A few things you should know": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et par ting, du bør vide"
          }
        }
      }
    },
    "A receipt that proves you shared with %@ — the result only, never your raw data. Revocable, and recorded on your consent evidence.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En kvittering, der beviser, at du delte med %@ — kun resultatet, aldrig dine rådata. Kan tilbagekaldes og står på dit samtykkebevis."
          }
        }
      }
    },
