    "%@ asked to record this call. Only you can allow it — and you can stop any time." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har bedt om at optage denne samtale. Kun du kan tillade det — og du kan stoppe når som helst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha pedido grabar esta llamada. Solo tú puedes permitirlo — y puedes parar en cualquier momento."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har bedt om å ta opp denne samtalen. Bare du kan tillate det — og du kan stoppe når som helst."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pediu para gravar esta chamada. Só você pode permitir — e pode parar a qualquer momento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har bett om att spela in samtalet. Bara du kan tillåta det — och du kan stoppa när som helst."
          }
        }
      }
    },
    "%@ can no longer see anything. It happened the instant you tapped — and it's on your record." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan ikke længere se noget. Det skete i samme øjeblik, du trykkede — og det står i din log."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no puede ver nada. Ocurrió en el instante en que tocaste — y consta en tu registro."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan ikke lenger se noe. Det skjedde i samme øyeblikk du trykket — og det står i loggen din."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ já não consegue ver nada. Aconteceu no instante em que tocou — e está no seu registo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan inte längre se något. Det skedde i samma ögonblick du tryckte — och det står i din logg."
          }
        }
      }
    },
    "%@ is ready to talk" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er klar til at tale"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está listo para hablar"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er klar til å snakke"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está pronto para falar"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ är redo att prata"
          }
        }
      }
    },
    "%@ sees your request and confirms. You can add it to your calendar." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ser din forespørgsel og bekræfter. Du kan lægge den i din kalender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ve tu solicitud y confirma. Puedes añadirla a tu calendario."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ser forespørselen din og bekrefter. Du kan legge den i kalenderen din."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vê o seu pedido e confirma. Pode adicioná-lo ao seu calendário."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ser din förfrågan och bekräftar. Du kan lägga in den i din kalender."
          }
        }
      }
    },
    "%@ will confirm your %@ · %@ consultation. We'll notify you here." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bekræfter din konsultation %2$@ · %3$@. Vi giver dig besked her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ will confirm your %2$@ · %3$@ consultation. We'll notify you here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ confirmará tu consulta %2$@ · %3$@. Te avisaremos aquí."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bekrefter konsultasjonen din %2$@ · %3$@. Vi varsler deg her."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ confirmará a sua consulta %2$@ · %3$@. Avisamos aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bekräftar din konsultation %2$@ · %3$@. Vi meddelar dig här."
          }
        }
      }
    },
