    "Twice daily" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To gange dagligt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos veces al día"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ganger daglig"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duas vezes por dia"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Två gånger dagligen"
          }
        }
      }
    },
    "Two trackers logged the same session. Liviqa counts it once so minutes and energy are never doubled — and keeps the best of both recordings for insights." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To enheder loggede samme træning. Liviqa tæller den én gang, så minutter og energi aldrig fordobles — og beholder det bedste fra begge optagelser til indsigterne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos dispositivos registraron la misma sesión. Liviqa la cuenta una sola vez para que minutos y energía nunca se dupliquen — y conserva lo mejor de ambos registros para las observaciones."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To enheter logget samme økt. Liviqa teller den én gang, så minutter og energi aldri dobles — og beholder det beste fra begge opptak til innsiktene."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dois dispositivos registaram a mesma sessão. O Liviqa conta-a uma vez, para que minutos e energia nunca dupliquem — e mantém o melhor de ambos os registos para as observações."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Två enheter loggade samma pass. Liviqa räknar det en gång så att minuter och energi aldrig dubbleras — och behåller det bästa från båda inspelningarna för insikter."
          }
        }
      }
    },
