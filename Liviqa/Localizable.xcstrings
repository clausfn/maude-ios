    },
    "Your name, date of birth and address are never revealed to Liviqa — only the facts above are proven." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit navn, din fødselsdato og din adresse afsløres aldrig for Liviqa — kun oplysningerne ovenfor bevises."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nombre, fecha de nacimiento y dirección nunca se revelan a Liviqa — solo se prueban los datos anteriores."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navnet ditt, fødselsdatoen din og adressen din avsløres aldri for Liviqa — bare opplysningene ovenfor bevises."
          }
        },
        "pt" : {
          "stringUnit" : {
