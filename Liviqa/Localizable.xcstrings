        }
      }
    },
    "The continuous relationship (the overlay timeline and scatter) lives in your full history — this split is the part you can act on." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den løbende sammenhæng (tidslinjen og punktdiagrammet) ligger i din fulde historik — denne opdeling er den del, du kan handle på."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La relación continua (la línea temporal superpuesta y la dispersión) vive en tu historial completo — esta división es la parte sobre la que puedes actuar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den løpende sammenhengen (tidslinjen og punktdiagrammet) ligger i hele historikken din — denne oppdelingen er delen du kan handle på."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A relação contínua (a linha temporal sobreposta e a dispersão) vive no seu histórico completo — esta divisão é a parte sobre a qual pode agir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det löpande sambandet (tidslinjen och punktdiagrammet) finns i din fulla historik — denna uppdelning är delen du kan agera på."
