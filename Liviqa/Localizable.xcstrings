    "%@%@ can see only the summary you've consented to share — not your raw data, which stays on your device." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@ kan kun se det sammendrag, du har givet samtykke til at dele — ikke dine rådata, som bliver på din enhed."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@%2$@ can see only the summary you've consented to share — not your raw data, which stays on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@ solo puede ver el resumen que has consentido compartir — no tus datos en bruto, que permanecen en tu dispositivo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@ kan bare se sammendraget du har samtykket til å dele — ikke rådataene dine, som blir på enheten din."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@ só pode ver o resumo que consentiu partilhar — não os seus dados em bruto, que ficam no seu dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@ kan bara se den sammanfattning du samtyckt till att dela — inte dina rådata, som stannar på din enhet."
          }
        }
      }
    },
