          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glukosen din ligger i dag over ditt vanlige nivå. En kort tur etter måltider hjelper mange. Fortsetter det, er det verdt å ta opp med %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua glicose hoje está acima do seu intervalo habitual. Uma caminhada curta após as refeições ajuda muitas pessoas. Se persistir, vale a pena falar com %@."
          }
        },
        "sv" : {
          "stringUnit" : {
