      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen er krypteret på din enhed. Forhåndsvisning åbner, når produktionsmiljøet er live."
          }
        }
      }
    },
    "This is a pattern in your own data — not a medical finding. Worth discussing with your care team if it repeats.": {
