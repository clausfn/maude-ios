    "Your rights under GDPR Articles 15–22 apply in full. Full legal text at liviqa.app/privacy" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine rettigheder efter GDPR artikel 15–22 gælder fuldt ud. Den fulde juridiske tekst findes på liviqa.app/privacy"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus derechos según los artículos 15–22 del RGPD se aplican plenamente. Texto legal completo en liviqa.app/privacy"
          }
        },
        "nb" : {
          "stringUnit" : {
