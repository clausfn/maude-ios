    "%@ · %@": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ asked to record this call. Only you can allow it — and you can stop any time.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har bedt om at optage denne samtale. Kun du kan tillade det — og du kan stoppe når som helst."
          }
        }
      }
    },
    "%@ can no longer see anything. It happened the instant you tapped — and it's on your record.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan ikke længere se noget. Det skete i samme øjeblik, du trykkede — og det står i din log."
          }
        }
      }
    },
    "%@ is ready to talk": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er klar til at tale"
          }
        }
      }
    },
    "%@ sees your request and confirms. You can add it to your calendar.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ser din forespørgsel og bekræfter. Du kan lægge den i din kalender."
          }
        }
      }
    },
    "%@ will confirm your %@ · %@ consultation. We'll notify you here.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bekræfter din konsultation %2$@ · %3$@. Vi giver dig besked her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ will confirm your %2$@ · %3$@ consultation. We'll notify you here."
          }
        }
      }
    },
    "%@, %@: %@": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@: %3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$@: %3$@"
          }
        }
      }
    },
    "%@%@ can see only the summary you've consented to share — not your raw data, which stays on your device.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$@ kan kun se det sammendrag, du har givet samtykke til at dele — ikke dine rådata, som bliver på din enhed."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$@ can see only the summary you've consented to share — not your raw data, which stays on your device."
          }
        }
      }
    },
