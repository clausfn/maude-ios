    "Used to contextualise patterns — e.g. glucose drops after cycling at this intensity." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til at sætte mønstre i kontekst — fx at glukose falder efter cykling ved denne intensitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para contextualizar patrones — p. ej., la glucosa baja después de pedalear a esta intensidad."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes til å sette mønstre i kontekst — f.eks. at glukosen faller etter sykling med denne intensiteten."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para contextualizar padrões — p. ex., a glicose desce depois de pedalar a esta intensidade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används för att sätta mönster i sammanhang — t.ex. att glukosen sjunker efter cykling i denna intensitet."
          }
        }
      }
    },
    "Used to pre-fill consent recipients. Role matters more than a person's name — people change, roles persist." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til at forudfylde samtykkemodtagere. Rollen betyder mere end navnet — personer skifter, roller består."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para precargar destinatarios de consentimiento. El rol importa más que el nombre — las personas cambian, los roles permanecen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes til å forhåndsutfylle samtykkemottakere. Rollen betyr mer enn navnet — personer skifter, roller består."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para pré-preencher destinatários de consentimento. O papel importa mais do que o nome — as pessoas mudam, os papéis ficam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används för att förifylla samtyckesmottagare. Rollen betyder mer än namnet — personer byts, roller består."
          }
        }
      }
    },
