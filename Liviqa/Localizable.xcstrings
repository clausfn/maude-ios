      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Norsk"
          }
        }
      }
    },
    "Not in your wallet yet? Get your Liviqa Citizen credential": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke i din wallet endnu? Få din Liviqa Citizen-legitimation"
          }
        }
      }
    },
    "Note saved": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Note gemt"
          }
        }
      }
    },
    "Nothing here yet": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet her endnu"
          }
        }
      }
    },
    "Nothing is shared by default.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet deles som standard."
          }
        }
      }
    },
    "Nudge Settings": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsigtsindstillinger"
          }
        }
      }
    },
    "Nudges are first-person observations generated from your own data. They are not medical advice. Always consult a qualified healthcare professional before making changes to your care or medication.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsigter er observationer i første person dannet af dine egne data. De er ikke medicinsk rådgivning. Tal altid med en kvalificeret sundhedsperson, før du ændrer din behandling eller medicin."
          }
        }
      }
    },
    "Nudges are observations from your own data. They are not alerts, medical warnings, or diagnostic tools.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsigter er observationer fra dine egne data. De er ikke alarmer, medicinske advarsler eller diagnostiske værktøjer."
          }
        }
      }
    },
