    "You can't be quietly overridden. Every access request is logged. Every refusal is logged. You can inspect the full record at any time." : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikke tilsidesættes i det stille. Hver adgangsforespørgsel logges. Hvert afslag logges. Du kan til enhver tid se hele loggen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se te puede ignorar en silencio. Cada solicitud de acceso se registra. Cada rechazo se registra. Puedes inspeccionar el registro completo en cualquier momento."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikke overstyres i det stille. Hver tilgangsforespørsel logges. Hvert avslag logges. Du kan når som helst se hele loggen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não pode ser ultrapassado em silêncio. Cada pedido de acesso é registado. Cada recusa é registada. Pode inspecionar o registo completo a qualquer momento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan inte åsidosättas i det tysta. Varje åtkomstbegäran loggas. Varje avslag loggas. Du kan när som helst granska hela loggen."
          }
        }
      }
    },
    "You earn tokens when your device contributes to anonymised research queries. Your health data never leaves this phone." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du optjener tokens, når din enhed bidrager til anonymiserede forskningsforespørgsler. Dine sundhedsdata forlader aldrig denne telefon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganas tokens cuando tu dispositivo contribuye a consultas de investigación anonimizadas. Tus datos de salud nunca salen de este teléfono."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tjener tokens når enheten din bidrar til anonymiserte forskningsspørringer. Helsedataene dine forlater aldri denne telefonen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganha tokens quando o seu dispositivo contribui para consultas de investigação anonimizadas. Os seus dados de saúde nunca saem deste telemóvel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tjänar tokens när din enhet bidrar till anonymiserade forskningsfrågor. Dina hälsodata lämnar aldrig denna telefon."
          }
        }
      }
    },
    "You haven't shared data with anyone. This is the default." : {
