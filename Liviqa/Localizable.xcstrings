    "Your data belongs to you. Liviqa has no access to your raw records." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data tilhører dig. Liviqa har ingen adgang til dine rå optegnelser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos te pertenecen. Liviqa no tiene acceso a tus registros en bruto."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dataene dine tilhører deg. Liviqa har ingen tilgang til de rå opptegnelsene dine."
