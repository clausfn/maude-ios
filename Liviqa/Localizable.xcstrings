    "Travel week ahead. Last three trips dropped your activity 40%. Yourcoach.health can share your prep plan with your coach if you allow it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejseuge forude. De sidste tre rejser sænkede din aktivitet 40%. Yourcoach.health kan dele din forberedelsesplan med din coach, hvis du tillader det."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semana de viaje por delante. Los últimos tres viajes redujeron tu actividad un 40%. Yourcoach.health puede compartir tu plan de preparación con tu coach si lo permites."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reiseuke i vente. De siste tre reisene senket aktiviteten din 40%. Yourcoach.health kan dele forberedelsesplanen din med coachen din hvis du tillater det."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semana de viagem pela frente. As últimas três viagens reduziram a sua atividade em 40%. A Yourcoach.health pode partilhar o seu plano de preparação com o seu coach se permitir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resvecka framför dig. De senaste tre resorna sänkte din aktivitet 40%. Yourcoach.health kan dela din förberedelseplan med din coach om du tillåter det."
          }
        }
      }
    },
