    "e.g. Low-carbohydrate, Mediterranean, no restriction" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fx Lavkulhydrat, middelhavskost, ingen begrænsning"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "p. ej., baja en carbohidratos, mediterránea, sin restricción"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "f.eks. lavkarbo, middelhavskost, ingen begrensning"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "p. ex., baixo em hidratos, mediterrânica, sem restrição"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "t.ex. lågkolhydrat, medelhavskost, ingen begränsning"
