    "Your care team" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit behandlerteam"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu equipo asistencial"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandlingsteamet ditt"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua equipa de cuidados"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt vårdteam"
          }
        }
      }
    },
    "Your care team can view your patterns for 48 hours. This sharing is logged in your privacy record." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit behandlerteam kan se dine mønstre i 48 timer. Delingen registreres i din privatlivslog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu equipo asistencial puede ver tus patrones durante 48 horas. Esta compartición queda en tu registro de privacidad."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandlingsteamet ditt kan se mønstrene dine i 48 timer. Delingen registreres i personvernloggen din."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua equipa de cuidados pode ver os seus padrões durante 48 horas. Esta partilha fica no seu registo de privacidade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt vårdteam kan se dina mönster i 48 timmar. Delningen loggas i din integritetslogg."
          }
        }
      }
    },
    "Your care team, on your terms" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit behandlerteam, på dine vilkår"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu equipo asistencial, en tus términos"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandlingsteamet ditt, på dine vilkår"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua equipa de cuidados, nos seus termos"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt vårdteam, på dina villkor"
          }
        }
      }
    },
    "Your consent decisions are independently logged and cannot be edited by anyone — including Liviqa." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine samtykkebeslutninger logges uafhængigt og kan ikke redigeres af nogen — heller ikke Liviqa."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus decisiones de consentimiento se registran de forma independiente y nadie puede editarlas — ni siquiera Liviqa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtykkebeslutningene dine logges uavhengig og kan ikke redigeres av noen — heller ikke Liviqa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As suas decisões de consentimento são registadas de forma independente e ninguém as pode editar — incluindo o Liviqa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina samtyckesbeslut loggas oberoende och kan inte redigeras av någon — inte heller Liviqa."
          }
        }
      }
    },
    "Your data belongs to you. Liviqa has no access to your raw records." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data tilhører dig. Liviqa har ingen adgang til dine rå optegnelser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos te pertenecen. Liviqa no tiene acceso a tus registros en bruto."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dataene dine tilhører deg. Liviqa har ingen tilgang til de rå opptegnelsene dine."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus dados pertencem-lhe. O Liviqa não tem acesso aos seus registos em bruto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina data tillhör dig. Liviqa har ingen åtkomst till dina råa uppgifter."
          }
        }
      }
    },
    "Your data lives where you choose." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data bor der, hvor du vælger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos viven donde tú elijas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dataene dine bor der du velger."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus dados vivem onde escolher."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina data bor där du väljer."
          }
        }
      }
    },
    "Your data stays on this phone. You decide every exception, one by one." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data bliver på denne telefon. Du bestemmer hver undtagelse, én ad gangen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos permanecen en este teléfono. Tú decides cada excepción, una a una."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dataene dine blir på denne telefonen. Du bestemmer hvert unntak, ett om gangen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus dados ficam neste telemóvel. Você decide cada exceção, uma a uma."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina data stannar på denna telefon. Du bestämmer varje undantag, ett i taget."
          }
        }
      }
    },
    "Your data stays on your device.\nNothing leaves without your consent." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data bliver på din enhed.\nIntet forlader den uden dit samtykke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos permanecen en tu dispositivo.\nNada sale sin tu consentimiento."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dataene dine blir på enheten din.\nIngenting forlater den uten ditt samtykke."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus dados ficam no seu dispositivo.\nNada sai sem o seu consentimento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina data stannar på din enhet.\nInget lämnar den utan ditt samtycke."
          }
        }
      }
    },
    "YOUR DATA, YOUR WAY" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DINE DATA, PÅ DIN MÅDE"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TUS DATOS, A TU MANERA"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DINE DATA, PÅ DIN MÅTE"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OS SEUS DADOS, À SUA MANEIRA"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DINA DATA, PÅ DITT SÄTT"
          }
        }
      }
    },
    "Your documents, on this device, encrypted. File previews open after the live production test — until then the vault shows files, not contents." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine dokumenter, på denne enhed, krypteret. Forhåndsvisning åbner efter den endelige produktionstest — indtil da viser Health Vault filer, ikke indhold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus documentos, en este dispositivo, cifrados. Las vistas previas se abren tras la prueba de producción — hasta entonces el Health Vault muestra archivos, no contenidos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumentene dine, på denne enheten, kryptert. Forhåndsvisning åpner etter den endelige produksjonstesten — til da viser Health Vault filer, ikke innhold."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus documentos, neste dispositivo, encriptados. As pré-visualizações abrem após o teste de produção — até lá o Health Vault mostra ficheiros, não conteúdos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina dokument, på denna enhet, krypterade. Förhandsvisning öppnas efter det skarpa produktionstestet — tills dess visar Health Vault filer, inte innehåll."
          }
        }
      }
    },
    "Your financial patterns stay in your Health Vault on this phone, beside your other documents. Encrypted, never part of any clinician share, never sent anywhere. Disconnect and erase them in one tap, any time." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine økonomiske mønstre bliver i din Health Vault på denne telefon, side om side med dine andre dokumenter. Krypteret, aldrig en del af nogen deling med klinikere, aldrig sendt nogen steder hen. Afbryd og slet dem med ét tryk, når som helst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus patrones financieros permanecen en tu Health Vault en este teléfono, junto a tus otros documentos. Cifrados, nunca parte de ninguna compartición clínica, nunca enviados a ningún sitio. Desconéctalos y bórralos con un toque, cuando quieras."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De økonomiske mønstrene dine blir i din Health Vault på denne telefonen, ved siden av de andre dokumentene dine. Kryptert, aldri en del av noen deling med klinikere, aldri sendt noe sted. Koble fra og slett dem med ett trykk, når som helst."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus padrões financeiros ficam no seu Health Vault neste telemóvel, ao lado dos seus outros documentos. Encriptados, nunca parte de qualquer partilha com clínicos, nunca enviados. Desligue e apague-os com um toque, a qualquer momento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina ekonomiska mönster stannar i din Health Vault på denna telefon, bredvid dina andra dokument. Krypterade, aldrig en del av någon delning med kliniker, aldrig skickade någonstans. Koppla från och radera dem med ett tryck, när som helst."
          }
        }
      }
    },
    "Your first grant or refusal will appear here." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din første tilladelse eller dit første afslag vises her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu primera concesión o rechazo aparecerá aquí."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din første tillatelse eller ditt første avslag vises her."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua primeira autorização ou recusa aparecerá aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt första medgivande eller avslag visas här."
          }
        }
      }
    },
    "Your identity is confirmed and your consent is anchored on the immutable CE ledger." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din identitet er bekræftet, og dit samtykke er forankret i den uforanderlige CE-hovedbog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu identidad está confirmada y tu consentimiento queda anclado en el libro mayor CE inmutable."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identiteten din er bekreftet, og samtykket ditt er forankret i den uforanderlige CE-hovedboken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua identidade está confirmada e o seu consentimento está ancorado no livro-razão CE imutável."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din identitet är bekräftad och ditt samtycke är förankrat i den oföränderliga CE-liggaren."
          }
        }
      }
    },
    "Your identity is confirmed. Only the facts you approved were shared with Liviqa." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din identitet er bekræftet. Kun de oplysninger, du godkendte, blev delt med Liviqa."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu identidad está confirmada. Solo los datos que aprobaste se compartieron con Liviqa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identiteten din er bekreftet. Bare opplysningene du godkjente, ble delt med Liviqa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
