    "Join": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltag"
          }
        }
      }
    },
    "Joining shares this secure call. Your data stays on your device — your clinician sees only what you've consented to. Recording stays off unless you allow it in the call.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du deltager, deles dette sikre opkald. Dine data bliver på din enhed — din kliniker ser kun det, du har givet samtykke til. Optagelse er slået fra, medmindre du tillader den i opkaldet."
          }
        }
      }
    },
    "Journal": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagbog"
          }
        }
      }
    },
    "Kept %@ for counting · merged %@%@": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholdt %1$@ til optælling · sammenlagt %2$@%3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Kept %1$@ for counting · merged %2$@%3$@"
          }
        }
      }
