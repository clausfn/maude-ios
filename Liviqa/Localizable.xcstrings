    "Withdrawing stops future sharing immediately. Completed analyses are not affected. Every change is logged." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbagekaldelse stopper fremtidig deling med det samme. Afsluttede analyser påvirkes ikke. Hver ændring logges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirar detiene la compartición futura de inmediato. Los análisis completados no se ven afectados. Cada cambio queda registrado."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbaketrekking stopper fremtidig deling umiddelbart. Fullførte analyser påvirkes ikke. Hver endring logges."
