      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine samtykkebeslutninger logges uafhængigt og kan ikke redigeres af nogen — heller ikke Liviqa."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus decisiones de consentimiento se registran de forma independiente y nadie puede editarlas — ni siquiera Liviqa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtykkebeslutningene dine logges uavhengig og kan ikke redigeres av noen — heller ikke Liviqa."
