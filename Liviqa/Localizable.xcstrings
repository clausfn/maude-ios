    "Keep wearing it to sleep. We'll surface this the moment it's real — about 19 nights from now." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliv ved med at sove med den på. Vi viser det, i det øjeblik det er reelt — om cirka 19 nætter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue llevándolo para dormir. Lo mostraremos en cuanto sea real — en unas 19 noches."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsett å sove med den på. Vi viser det i det øyeblikket det er reelt — om cirka 19 netter."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue a usá-lo para dormir. Mostraremos assim que for real — daqui a cerca de 19 noites."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsätt att sova med den på. Vi visar det i samma stund det är verkligt — om cirka 19 nätter."
          }
        }
      }
    },
    "Keeping your water topped up could help." : {
