      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din %1$@ %2$@ skilte sig mest ud fra dit sædvanlige i denne uge, sammen med udsving i %3$@. Værd at se på — det er dit mønster at læse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu %1$@ del %2$@ fue lo que más se desvió de lo habitual esta semana, junto con cambios en %3$@. Merece un vistazo — es tu patrón."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din %1$@ %2$@ skilte seg mest ut fra ditt vanlige denne uken, sammen med endringer i %3$@. Verdt en titt — det er ditt mønster å lese."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu %1$@ de %2$@ foi o que mais se destacou do habitual esta semana, juntamente com variações em %3$@. Vale a pena ver — o padrão é seu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din %1$@ i %2$@s skilde sig mest från ditt vanliga den här veckan, tillsammans med skiften i %3$@. Värt en titt — det är ditt mönster att läsa."
          }
        }
      }
    },
