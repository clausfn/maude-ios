    "Join" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deltag"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unirse"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bli med"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrar"
          }
        },
        "sv" : {
