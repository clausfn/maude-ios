            "value" : "DETALJERNA"
          }
        }
      }
    },
    "The rest of Liviqa works without enabling the assistant. You can turn it off anytime, which deletes the conversation." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resten af Liviqa virker uden assistenten. Du kan slå den fra når som helst, hvilket sletter samtalen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El resto de Liviqa funciona sin activar el asistente. Puedes desactivarlo cuando quieras, lo que borra la conversación."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resten av Liviqa fungerer uten assistenten. Du kan slå den av når som helst, noe som sletter samtalen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O resto do Liviqa funciona sem ativar o assistente. Pode desligá-lo a qualquer momento, o que apaga a conversa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resten av Liviqa fungerar utan assistenten. Du kan stänga av den när som helst, vilket raderar konversationen."
          }
        }
      }
    },
    "Theme" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tema"
          }
        },
        "es" : {
