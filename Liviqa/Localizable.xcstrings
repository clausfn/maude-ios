    "Your data never leaves this device. No backup — if you lose your phone, your history is gone." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data forlader aldrig denne enhed. Ingen backup — mister du din telefon, er din historik væk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos nunca salen de este dispositivo. Sin copia de seguridad — si pierdes el teléfono, tu historial desaparece."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dataene dine forlater aldri denne enheten. Ingen sikkerhetskopi — mister du telefonen, er historikken borte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus dados nunca saem deste dispositivo. Sem cópia de segurança — se perder o telefone, o seu histórico desaparece."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina data lämnar aldrig den här enheten. Ingen säkerhetskopia — tappar du telefonen är historiken borta."
          }
        }
      }
    },
    "Your data stays on this phone. You decide every exception, one by one." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data bliver på denne telefon. Du bestemmer hver undtagelse, én ad gangen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos permanecen en este teléfono. Tú decides cada excepción, una a una."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dataene dine blir på denne telefonen. Du bestemmer hvert unntak, ett om gangen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
