            "value" : "Takk. Kveldsturene ser ut til å hjelpe på nattetallene."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrigado. As caminhadas ao fim do dia parecem ajudar os valores noturnos."
