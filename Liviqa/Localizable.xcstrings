        }
      }
    },
    "Each time you grant or withdraw access, that decision is written to an independent record. It cannot be edited, deleted, or backdated — by anyone, including Liviqa." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang du giver eller trækker adgang tilbage, skrives beslutningen til en uafhængig log. Den kan ikke redigeres, slettes eller tilbagedateres — af nogen, heller ikke Liviqa."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que concedes o retiras acceso, esa decisión se escribe en un registro independiente. No puede editarse, borrarse ni retrodatarse — por nadie, ni siquiera Liviqa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang du gir eller trekker tilbake tilgang, skrives beslutningen til en uavhengig logg. Den kan ikke redigeres, slettes eller tilbakedateres — av noen, heller ikke Liviqa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre que concede ou retira acesso, essa decisão é escrita num registo independente. Não pode ser editada, eliminada nem antedatada — por ninguém, incluindo o Liviqa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje gång du ger eller återkallar åtkomst skrivs beslutet till en oberoende logg. Den kan inte redigeras, raderas eller efterdateras — av någon, inte heller Liviqa."
          }
        }
      }
    },
    "Earned" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optjent"
          }
        },
        "es" : {
