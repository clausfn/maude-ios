    "A receipt that proves you shared with %@ — the result only, never your raw data. Revocable, and recorded on your consent evidence." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kvittering, der beviser, at du delte med %@ — kun resultatet, aldrig dine rådata. Kan tilbagekaldes og står på dit samtykkebevis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un recibo que demuestra que compartiste con %@ — solo el resultado, nunca tus datos en bruto. Revocable y registrado en tu evidencia de consentimiento."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kvittering som beviser at du delte med %@ — bare resultatet, aldri rådataene dine. Kan tilbakekalles, og står på samtykkebeviset ditt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um recibo que prova que partilhou com %@ — apenas o resultado, nunca os seus dados em bruto. Revogável e registado na sua evidência de consentimento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett kvitto som bevisar att du delade med %@ — bara resultatet, aldrig dina rådata. Återkallbart och registrerat i ditt samtyckesbevis."
          }
        }
      }
    },
