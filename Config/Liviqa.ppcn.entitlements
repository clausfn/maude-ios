<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TEMPORARY PPCN beta entitlements (2026-07-07): HealthKit only.
	     App Groups + Sign in with Apple are dropped for the beta because headless
	     cloud-signing with an ASC API key cannot register them, and SIWA would fail
	     backend audience validation under the xyz.ppcn.liviqa bundle ID anyway.
	     The canonical entitlements remain Liviqa/Liviqa.entitlements (DfG builds). -->
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
